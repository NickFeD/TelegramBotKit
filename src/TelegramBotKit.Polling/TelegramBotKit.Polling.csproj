<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>TelegramBotKit.Polling</PackageId>
    <Description>Long-polling delivery using TelegramBotKit shared update execution.</Description>
    <PackageTags>telegram;telegram-bot;bot;polling;dotnet</PackageTags>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../TelegramBotKit.Hosting/TelegramBotKit.Hosting.csproj" />
  </ItemGroup>
</Project>

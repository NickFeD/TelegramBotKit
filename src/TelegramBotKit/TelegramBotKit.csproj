<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0;net11.0</TargetFrameworks>
    <LangVersion>14.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>TelegramBotKit</PackageId>
    <Description>Toolkit for building Telegram bots with commands, middleware and lightweight request/response waits.</Description>
    <PackageTags>telegram;telegram-bot;bot;middleware;commands;dotnet</PackageTags>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Keyboards\Keyboard.PagedInline.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Keyboards\Keyboard.PagedInline.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.3" />
    <PackageReference Include="Telegram.Bot" Version="22.9.0" />
    <!-- Older SDKs do not prune Telegram.Bot's JSON dependency against the shared framework. -->
    <PackageReference Include="System.Text.Json" Version="10.0.15" Condition="'$(TargetFramework)' == 'net8.0' Or '$(TargetFramework)' == 'net9.0'" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="Microsoft.SourceLink.GitHub" Version="10.0.111" />
    <ProjectReference Include="../TelegramBotKit.Generators/TelegramBotKit.Generators.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <None Include="../TelegramBotKit.Generators/bin/$(Configuration)/netstandard2.0/TelegramBotKit.Generators.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

</Project>

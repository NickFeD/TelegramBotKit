<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>

		<IsPackable>true</IsPackable>

		<!-- Analyzer / Source Generator package -->
		<PackageType>Analyzer</PackageType>
		<IsRoslynAnalyzer>true</IsRoslynAnalyzer>

		<!-- Не кладём ничего в lib/ref -->
		<IncludeBuildOutput>false</IncludeBuildOutput>

		<!-- Чтобы не лепились dependency groups в nuspec -->
		<SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>

		<PackageId>TelegramBotKit.Generators</PackageId>
		<AssemblyName>TelegramBotKit.Generators</AssemblyName>
		<RootNamespace>TelegramBotKit.Generators</RootNamespace>
		<Description>Roslyn source generator for TelegramBotKit that generates AddCommands() registrations at compile time.</Description>
		<PackageTags>telegram;telegram-bot;bot;source-generator;analyzer;dotnet</PackageTags>

		<GenerateDocumentationFile>false</GenerateDocumentationFile>

		<EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>

		<!-- Если где-то в решении включена генерация snupkg, для генератора лучше отключить -->
		<IncludeSymbols>false</IncludeSymbols>

		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" PrivateAssets="all" />
	</ItemGroup>

	<!-- ВАЖНО: упаковываем именно собранную DLL генератора -->
	<ItemGroup>
		<None Include="$(TargetPath)"
			  Pack="true"
			  PackagePath="analyzers/dotnet/cs"
			  Visible="false" />

		<None Include="$(TargetDir)$(AssemblyName).pdb"
			  Pack="true"
			  PackagePath="analyzers/dotnet/cs"
			  Visible="false"
			  Condition="Exists('$(TargetDir)$(AssemblyName).pdb')" />
	</ItemGroup>

	<ItemGroup>
		<!-- SourceLink: строго как build-time dependency -->
		<PackageReference Include="Microsoft.SourceLink.GitHub"
				  Version="10.0.103"
				  PrivateAssets="all" />
	</ItemGroup>

</Project>